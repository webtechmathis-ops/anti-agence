---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../data/site';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  breadcrumb?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, path, ogImage = '/og-default.jpg', breadcrumb, schema = [], noindex = false } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const id = (fragment: string) => `${SITE.url}/#${fragment}`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': id('website'),
    url: `${SITE.url}/`,
    name: SITE.name,
    inLanguage: 'fr-FR',
    publisher: { '@id': id('org') },
  },
  {
    '@type': 'ProfessionalService',
    '@id': id('org'),
    name: SITE.name,
    url: `${SITE.url}/`,
    logo: `${SITE.url}/apple-touch-icon.png`,
    image: `${SITE.url}/og-default.jpg`,
    email: SITE.email,
    telephone: '+33770178933',
    founder: { '@id': id('mathis') },
    areaServed: [
      { '@type': 'City', name: 'Vernon' },
      { '@type': 'AdministrativeArea', name: 'Eure' },
    ],
    knowsAbout: ['Création de site internet', 'Référencement naturel (SEO)', 'Generative Engine Optimization (GEO)', 'Google Ads'],
  },
  {
    '@type': 'Person',
    '@id': id('mathis'),
    name: SITE.owner,
    jobTitle: 'Consultant SEO et GEO freelance',
    worksFor: { '@id': id('org') },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: 'fr-FR',
    isPartOf: { '@id': id('website') },
    about: { '@id': id('org') },
    ...(breadcrumb ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
  },
  ...(breadcrumb
    ? [{
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: breadcrumb.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: new URL(c.path, site).href,
        })),
      }]
    : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header currentPath={path} />
    <main id="contenu">
      {breadcrumb && <Breadcrumb items={breadcrumb} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
