---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import FaqList from '../components/FaqList.astro';
import { FAQ_ACCUEIL, METHODE, METIERS, SERVICES, SITE, formatPrice } from '../data/site';
import { SITES } from '../data/tarifs';
import OfferBanner from '../components/OfferBanner.astro';
import CtaBand from '../components/CtaBand.astro';

import imgArtisan from '../assets/metiers/artisan-electricien.webp';
import imgCommercant from '../assets/metiers/commercant-fleuriste.webp';
import imgRestaurant from '../assets/metiers/restaurant-chef.webp';
import imgSpa from '../assets/metiers/spa-sauna.webp';

const metierImages = [
  { src: imgArtisan, alt: 'Électricien qui intervient sur un tableau électrique' },
  { src: imgCommercant, alt: 'Devanture de fleuriste garnie de bouquets' },
  { src: imgRestaurant, alt: 'Chef qui dresse des assiettes en cuisine' },
  { src: imgSpa, alt: 'Cliente qui se détend dans un sauna en bois' },
];

const ledger = [
  { elsewhere: 'Un commercial, un chef de projet, un stagiaire', here: 'Un seul interlocuteur : moi' },
  { elsewhere: 'Du jargon à chaque réunion', here: 'Des mots simples' },
  { elsewhere: 'Des prix « sur demande »', here: `Des prix affichés, dès ${formatPrice(840)}` },
  { elsewhere: 'Un devis qui se fait attendre', here: `Un devis sous ${SITE.quoteDelay}` },
];

const marquee = ['Création de site', 'SEO local', 'GEO', 'Google Ads', 'Netlinking', 'Vernon', 'Eure', 'Devis en 24 h'];

const schema = [
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#faq`,
    mainEntity: FAQ_ACCUEIL.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Création site internet et SEO à Vernon | Anti-Agence"
  description="Freelance à Vernon : création de site internet dès 840 €, référencement SEO local et GEO pour être cité par les IA. Devis gratuit sous 24 h."
  path="/"
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">{SITE.owner}, freelance web à Vernon (27)</p>
          <h1 class="display hero-title">Création de site internet et SEO à Vernon</h1>
          <p class="lead hero-lead">
            Je crée des sites rapides et je les fais remonter sur Google et dans les réponses des IA,
            pour les artisans, commerçants, restaurateurs et hôtels de l’Eure. Sites à partir de {formatPrice(840)},
            devis sous {SITE.quoteDelay}.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={SITE.ctaHref}>{SITE.ctaLabel}</a>
            <a class="btn btn-ghost" href="/tarifs/">Voir les tarifs</a>
          </div>
          <p class="hero-aside">(Moins de jargon, plus de clients.)</p>
        </div>

        <table class="ledger">
          <caption>Une agence web, sans les travers d’une agence</caption>
          <thead>
            <tr><th scope="col">Ailleurs</th><th scope="col">Ici</th></tr>
          </thead>
          <tbody>
            {ledger.map((row, i) => (
              <tr style={`--i:${i}`}>
                <td><s>{row.elsewhere}</s></td>
                <td>{row.here}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Marquee items={marquee} />

  <!-- Services -->
  <section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap split">
      <div class="split-head">
        <p class="ask">Mon terrain de jeu favori ?</p>
        <h2 class="h2" id="services-title">Être trouvé sur Google, et cité par les IA.</h2>
        <p class="split-intro muted">
          Avoir un site ne suffit pas s’il reste invisible. Je m’occupe de tout ce qui vous fait apparaître
          quand vos clients cherchent un professionnel près de chez eux.
        </p>
      </div>
      <ul role="list" class="services">
        {SERVICES.map((s) => (
          <li>
            <h3 class="h3">{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Métiers -->
  <section class="section section-tight-top" id="metiers" aria-labelledby="metiers-title">
    <div class="wrap">
      <p class="ask">Pour qui ?</p>
      <h2 class="h2 metiers-title" id="metiers-title">Ceux qui font vivre Vernon et l’Eure.</h2>
      <ul role="list" class="metiers">
        {METIERS.map((m, i) => (
          <li class="metier">
            <a href={m.href} class="metier-link">
              <Image
                src={metierImages[i].src}
                alt={metierImages[i].alt}
                width={760}
                widths={[360, 560, 760]}
                sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 25vw"
                class="metier-img"
              />
              <h3 class="h3 metier-name">{m.label}</h3>
            </a>
            <p class="muted">{m.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Méthode -->
  <section class="section section-ink" aria-labelledby="methode-title">
    <div class="wrap">
      <p class="ask ask-on-ink">Comment ça se passe ?</p>
      <h2 class="h2" id="methode-title">Trois étapes, un seul interlocuteur.</h2>
      <ol role="list" class="steps">
        {METHODE.map((step, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3 class="h3">{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Tarifs -->
  <section class="section" aria-labelledby="tarifs-title">
    <div class="wrap split">
      <div class="split-head">
        <p class="ask">Combien ça coûte ?</p>
        <h2 class="h2" id="tarifs-title">Des prix affichés avant de signer.</h2>
        <p class="split-intro muted">
          Prix de départ hors options. Packs SEO, réservation en ligne, logo et réseaux sociaux sont détaillés sur la page tarifs.
        </p>
        <a class="link" href="/tarifs/">Toutes les formules et options</a>
      </div>
      <table class="prices">
        <caption class="visually-hidden">Tarifs de création de site internet, à partir de</caption>
        <thead>
          <tr><th scope="col">Formule</th><th scope="col">Taille</th><th scope="col">À partir de</th></tr>
        </thead>
        <tbody>
          {SITES.map((s) => (
            <tr>
              <th scope="row">
                <span class="price-name">{s.name}</span>
                <span class="price-note">{s.note}</span>
              </th>
              <td>{s.pages}</td>
              <td class="price-amount">{formatPrice(s.price)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="wrap offer-row"><OfferBanner /></div>
  </section>

  <!-- GEO -->
  <section class="section geo" aria-labelledby="geo-title">
    <div class="wrap geo-inner">
      <div>
        <p class="ask">Et le GEO, c’est quoi ?</p>
        <h2 class="h2" id="geo-title">Le SEO, version moteurs IA.</h2>
        <div class="prose geo-text">
          <p>
            Le GEO (Generative Engine Optimization) consiste à optimiser vos contenus pour apparaître dans les réponses
            des intelligences artificielles comme ChatGPT, Perplexity ou Google AI Overviews.
          </p>
          <p>
            Il complète le SEO classique : quand un client demande à une IA « quel artisan à Vernon ? »,
            l’objectif est que votre entreprise fasse partie de la réponse.
          </p>
        </div>
        <a class="link" href="/geo-definition-seo/">Lire le guide complet du GEO</a>
      </div>
      <svg class="geo-mark" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
        <path d="M256 8A248 248 0 0 0 8 256h248z" />
        <path d="M256 504a248 248 0 0 0 248-248H256z" />
        <circle cx="374" cy="132" r="80" />
        <circle cx="139" cy="369" r="80" />
      </svg>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="wrap split">
      <div class="split-head">
        <p class="ask">Vous vous demandez sûrement…</p>
        <h2 class="h2" id="faq-title">Questions fréquentes</h2>
        <a class="link" href="/faq-seo-vernon/">Toutes les questions sur le SEO à Vernon</a>
      </div>
      <FaqList items={FAQ_ACCUEIL} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>

  /* Hero */
  .hero { padding-block: clamp(2.5rem, 1rem + 5vw, 5.5rem) clamp(3.5rem, 2rem + 5vw, 6.5rem); }
  .hero-kicker { font-weight: 600; margin-bottom: 1.25rem; }
  .hero-title { max-width: 12ch; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    align-items: end;
  }
  .hero-lead { margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero-aside { margin-top: 1.25rem; color: var(--muted); }

  /* Tableau « Ailleurs / Ici » : l'élément signature */
  .ledger { width: 100%; border-collapse: collapse; }
  .ledger caption {
    text-align: left;
    font-weight: 700;
    font-size: var(--fs-h3);
    font-variation-settings: 'opsz' 32;
    padding-bottom: 1rem;
  }
  .ledger th {
    text-align: left;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--muted);
    padding: 0 0 0.6rem;
    border-bottom: 2px solid var(--ink);
  }
  .ledger td {
    width: 50%;
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    line-height: 1.35;
  }
  .ledger td:last-child { font-weight: 700; padding-right: 0; }
  .ledger s {
    color: var(--muted);
    text-decoration: none;
    background: linear-gradient(var(--blue), var(--blue)) 0 58% / 100% 3px no-repeat;
    animation: strike 0.5s cubic-bezier(0.6, 0, 0.3, 1) both;
    animation-delay: calc(0.5s + var(--i) * 0.28s);
  }
  @keyframes strike { from { background-size: 0 3px; } }

  /* Services */
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    border-top: 2px solid var(--ink);
  }
  .services li { padding-block: 1.75rem; border-bottom: 1px solid var(--line); }
  .services p { margin-top: 0.6rem; }

  /* Métiers */
  .metiers-title { max-width: 14ch; }
  .metiers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  .metier-link { display: block; text-decoration: none; }
  .metier-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    transition: border-radius 0.25s ease;
  }
  .metier-link:hover .metier-img { border-radius: 50% 50% var(--radius) var(--radius) / 40% 40% var(--radius) var(--radius); }
  .metier-name { margin-top: 1rem; }
  .metier-link:hover .metier-name { text-decoration: underline; text-decoration-color: var(--blue); text-decoration-thickness: 0.12em; }
  .metier p { margin-top: 0.4rem; font-size: var(--fs-small); }

  /* Méthode */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    margin-top: clamp(2.5rem, 1rem + 4vw, 4.5rem);
  }
  .step { border-top: 1px solid #3a3a40; padding-top: 1.5rem; }
  .step-num {
    display: block;
    font-size: clamp(4rem, 2rem + 6vw, 7.5rem);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 0.85;
    color: var(--blue);
    margin-bottom: 1.25rem;
  }
  .step p { margin-top: 0.75rem; color: #c9c9cf; max-width: 36ch; }

  /* Tarifs */
  .prices { width: 100%; border-collapse: collapse; border-top: 2px solid var(--ink); }
  .prices thead th {
    text-align: left;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--muted);
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .prices thead th:last-child { text-align: right; white-space: nowrap; }
  .prices tbody th,
  .prices td { padding: 1.4rem 1rem 1.4rem 0; border-bottom: 1px solid var(--line); text-align: left; vertical-align: baseline; }
  .prices td:last-child { padding-right: 0; }
  .price-name { display: block; font-size: var(--fs-h3); font-weight: 700; }
  .price-note { display: block; font-size: var(--fs-small); font-weight: 400; color: var(--muted); margin-top: 0.2rem; }
  .prices .price-amount {
    text-align: right;
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.25rem);
    font-weight: 800;
    font-stretch: 80%;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .offer-row { margin-top: clamp(2.5rem, 1rem + 4vw, 4rem); }

  /* GEO */
  .geo { background: var(--blue-wash); }
  .geo-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: center;
  }
  .geo-text { margin-block: 1.5rem; }
  .geo-mark { width: 100%; max-width: 22rem; justify-self: end; fill: var(--blue); }

  /* Responsive */
  @media (max-width: 64rem) {
    .metiers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-grid,
    .geo-inner { grid-template-columns: minmax(0, 1fr); }
    .geo-mark { max-width: 9rem; justify-self: start; order: -1; }
  }
  @media (max-width: 48rem) {
    .services,
    .steps { grid-template-columns: minmax(0, 1fr); }
    .prices thead th:nth-child(2),
    .prices td:nth-child(2) { display: none; }
  }
  @media (max-width: 30rem) {
    .metiers { gap: 1.5rem 0.875rem; }
    .metier-name { font-size: 1.0625rem; }
    .ledger td { font-size: var(--fs-small); }
    .hero-actions .btn { width: 100%; }
  }
</style>
